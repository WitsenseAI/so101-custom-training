
# ─────────────────────────────────────────────────────────────────────────────
# 1. Hugging Face
# ─────────────────────────────────────────────────────────────────────────────
# Needs write access if you push the policy. https://huggingface.co/settings/tokens
export HF_TOKEN="${HF_TOKEN:-hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx}"

# Org (or username) the trained policy is pushed under.
export HF_ORG="${HF_ORG:-witsense-ai}"

# Any LeRobot-format dataset on the Hub. This is the only value most runs change.
export DATASET_REPO="${DATASET_REPO:-witsense-ai/so101_pick_and_place_ring_33}"

# Where the policy is pushed. Empty derives: $HF_ORG/<dataset-name>_act
export POLICY_REPO="${POLICY_REPO:-}"


export PUSH_TO_HUB="${PUSH_TO_HUB:-false}"
export PUSH_PRIVATE="${PUSH_PRIVATE:-true}"

# ─────────────────────────────────────────────────────────────────────────────
# 2. Caches and the venv — all three are created on demand, nothing to mkdir.
#    Point them at a disk with room: together they reach tens of GB.
# ─────────────────────────────────────────────────────────────────────────────

# Where lerobot materialises datasets, as <HF_LEROBOT_HOME>/<repo_id>. Created by lerobot
# the first time a dataset is used. ~0.5-50 GB depending on the dataset.
export HF_LEROBOT_HOME="${HF_LEROBOT_HOME:-$HOME/.cache/lerobot}"

# huggingface_hub's download cache (hub/, datasets/, xet/). Created on the first download.
#
# CAUTION: huggingface_hub also looks for the token from `hf auth login` under HF_HOME.
# Moving HF_HOME off the default hides that login, and a PRIVATE dataset then fails with a
# misleading "401 ... Repository Not Found" rather than "you are not authenticated".
# Public datasets keep working, so this only bites the first time you use a private one.
# Either set HF_TOKEN below, or copy ~/.cache/huggingface/token into this directory.
export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"

# The training venv: uv, Python 3.12, lerobot pinned to LEROBOT_REF in train_act.sh.
# scripts/train_act.sh builds it on first run if bin/lerobot-train is missing. ~7 GB.
# Separate from the Isaac Sim conda env on purpose — see "The two environments" in the
# README; they need incompatible numpy versions.
export LEROBOT_VENV="${LEROBOT_VENV:-$HOME/.venvs/lerobot}"

# ─────────────────────────────────────────────────────────────────────────────
# 3. Training
# ─────────────────────────────────────────────────────────────────────────────
export STEPS="${STEPS:-50000}"
# Drives VRAM. Measured with 2 cameras: batch 4 ~4.4 GB, batch 2 ~2.6 GB.
export BATCH_SIZE="${BATCH_SIZE:-4}"
export NUM_WORKERS="${NUM_WORKERS:-4}"
export SEED="${SEED:-1000}"
# Checkpoint every N steps.
export SAVE_FREQ="${SAVE_FREQ:-2000}"
export LOG_FREQ="${LOG_FREQ:-200}"

# ─────────────────────────────────────────────────────────────────────────────
# 4. Weights & Biases (optional)
# ─────────────────────────────────────────────────────────────────────────────
export WANDB_ENABLE="${WANDB_ENABLE:-false}"
export WANDB_PROJECT="${WANDB_PROJECT:-so101-act}"
# Empty uses your default entity.
export WANDB_ENTITY="${WANDB_ENTITY:-}"
# Or run `wandb login` once instead of setting this.
# export WANDB_API_KEY="${WANDB_API_KEY:-}"

# ─────────────────────────────────────────────────────────────────────────────
# 5. Robot hardware — for recording and on-robot eval only, not for training
# ─────────────────────────────────────────────────────────────────────────────
export ROBOT_LEADER_PORT="${ROBOT_LEADER_PORT:-/dev/ttyACM1}"
export ROBOT_FOLLOWER_PORT="${ROBOT_FOLLOWER_PORT:-/dev/ttyACM0}"
export LEADER_ID="${LEADER_ID:-left_leader}"
export FOLLOWER_ID="${FOLLOWER_ID:-left_follower}"
export TASK_DESC="${TASK_DESC:-pickup the ring and place it on the toy}"
export TOP_CAMERA="${TOP_CAMERA:-/dev/video2}"
export WRIST_CAMERA="${WRIST_CAMERA:-/dev/video4}"
export CAMERA_WIDTH="${CAMERA_WIDTH:-640}"
export CAMERA_HEIGHT="${CAMERA_HEIGHT:-480}"
